APP_RELEASE_STORE_PASSWORD=
APP_RELEASE_KEY_PASSWORD=

# Debug tokens (only for local development)
APPCHECK_DEBUG_TOKEN_ANDROID=
APPCHECK_DEBUG_TOKEN_IOS=

# Optional outbound services. Each one sends data off the device, so all are
# disabled while empty. Point them at infrastructure you control to enable them.

# Fallback web search for agents, used only if a You.com search fails.
# Upstream sent these queries to a SearXNG instance run by Mintplex Labs.
SEARXNG_BASE_URL=
SEARXNG_API_KEY=
SEARXNG_API_HEADER=

# Approximate location lookup for the agent "get location" tool. Whatever
# service you name here receives the device's IP address.
GEOLOCATION_API_URL=

# Release feed for the "update available" notice in settings. Should return a
# plain-text semantic version, e.g. 1.2.0
UPDATE_CHECK_URL=